{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "workloadName": { "value": "${AZURE_WORKLOAD_NAME=neo4j-mcp}" },
    "foundryPublicNetworkAccess": { "value": "${FOUNDRY_PUBLIC_NETWORK_ACCESS=Disabled}" },
    "foundryModelName": { "value": "${FOUNDRY_MODEL_NAME=gpt-5.5}" },
    "foundryModelVersion": { "value": "${FOUNDRY_MODEL_VERSION=2026-04-24}" },
    "foundryModelSkuName": { "value": "${FOUNDRY_MODEL_SKU=GlobalStandard}" },
    "foundryModelCapacity": { "value": "${FOUNDRY_MODEL_CAPACITY=30}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID=}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "containerImage": { "value": "${NEO4J_MCP_CONTAINER_IMAGE=neo4j/mcp:v1.5.3@sha256:fb2b7b486ecabdfb2792f1ac7eac401365cd836d83230edc9bcaa99bbf1bf727}" },
    "neo4jUri": { "value": "${NEO4J_URI=}" },
    "neo4jDatabase": { "value": "${NEO4J_DATABASE=neo4j}" },
    "neo4jAdminPassword": { "value": "${NEO4J_ADMIN_PASSWORD=}" },
    "neo4jAgentUsername": { "value": "${NEO4J_AGENT_USERNAME=agent}" },
    "neo4jAgentPassword": { "value": "${NEO4J_AGENT_PASSWORD}" },
    "neo4jNodeCount": { "value": "${NEO4J_NODE_COUNT=1}" },
    "neo4jVmSize": { "value": "${NEO4J_VM_SIZE=Standard_D4s_v5}" },
    "neo4jDataDiskSizeGb": { "value": "${NEO4J_DATA_DISK_SIZE_GB=256}" },
    "adminUsername": { "value": "${NEO4J_VM_ADMIN_USERNAME=azureuser}" },
    "sshPublicKey": { "value": "${NEO4J_VM_SSH_PUBLIC_KEY=}" },
    "neo4jVersion": { "value": "${NEO4J_VERSION=2026.07.1}" },
    "readOnly": { "value": "${NEO4J_READ_ONLY=true}" },
    "mcpPort": { "value": "${MCP_PORT=8000}" },
    "mcpMinReplicas": { "value": "${MCP_MIN_REPLICAS=1}" },
    "mcpMaxReplicas": { "value": "${MCP_MAX_REPLICAS=3}" },
    "mcpCpu": { "value": "${MCP_CPU=0.5}" },
    "mcpMemory": { "value": "${MCP_MEMORY=1Gi}" },
    "mcpConcurrentRequests": { "value": "${MCP_CONCURRENT_REQUESTS=20}" },
    "neo4jLogFormat": { "value": "${NEO4J_LOG_FORMAT=json}" },
    "neo4jTelemetry": { "value": "${NEO4J_TELEMETRY=true}" },
    "neo4jSchemaSampleSize": { "value": "${NEO4J_SCHEMA_SAMPLE_SIZE=100}" },
    "neo4jAllowedOrigins": { "value": "${NEO4J_MCP_HTTP_ALLOWED_ORIGINS=}" }
  }
}
